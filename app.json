{
  "expo": {
    "name": "aux",
    "slug": "aux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aux",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0908",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true
    },
    "android": {
      "package": "com.anushkulal.aux",
      "adaptiveIcon": {
        "backgroundColor": "#0a0908",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0908",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c252219-3619-434b-9ab4-f0931d09722a"
      },
      "releaseNotes": [
        "This sheet is the new update prompt — it rises from the bottom and lists the patch",
        "Navigation fades everywhere now; only a Session slides up",
        "Direct messages: inbox, threads and composer",
        "Follows light and dark with the rest of the app"
      ]
    },
    "owner": "anush_kulal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c252219-3619-434b-9ab4-f0931d09722a",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
