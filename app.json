{
  "expo": {
    "name": "aux",
    "slug": "aux",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aux",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1e2128",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true
    },
    "android": {
      "package": "com.anushkulal.aux",
      "adaptiveIcon": {
        "backgroundColor": "#0f1216",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.REQUEST_INSTALL_PACKAGES"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1e2128",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 140
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3c252219-3619-434b-9ab4-f0931d09722a"
      },
      "patch": 5,
      "releaseNotes": [
        "Server moved to Mumbai — roughly six times faster than before",
        "You will need to sign in again: this is a new database",
        "Settings can now check for and install a new app build"
      ],
      "changelog": [
        {
          "patch": 5,
          "notes": [
            "Server moved to Mumbai — roughly six times faster than before",
            "You will need to sign in again: this is a new database",
            "Settings can now check for and install a new app build"
          ]
        },
        {
          "patch": 4,
          "notes": [
            "Settings has a Software update section — apply an update you turned down earlier",
            "A strip at the top of the app shows when you are on an older version"
          ]
        },
        {
          "patch": 3,
          "notes": [
            "Update notes now cover every patch you skipped, not just the newest",
            "The update sheet rises from the bottom and follows light and dark"
          ]
        },
        {
          "patch": 2,
          "notes": [
            "Navigation fades everywhere; only a Session slides up",
            "Returning to a screen animates properly instead of snapping"
          ]
        },
        {
          "patch": 1,
          "notes": ["Direct messages: inbox, threads and composer"]
        }
      ]
    },
    "owner": "anush_kulal",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3c252219-3619-434b-9ab4-f0931d09722a",
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
