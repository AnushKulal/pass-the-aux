# Normalise line endings so the repo does not show as wholly modified when it
# moves between Windows and macOS/Linux (EAS builds run on Linux).
* text=auto eol=lf

# Binary assets must never be touched by EOL conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.mp3 binary
*.mp4 binary

# Generated — collapse in diffs and exclude from language stats on GitHub.
package-lock.json linguist-generated=true
